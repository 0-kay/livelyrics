# Copy to .env and fill in. Never commit .env.
PROVIDER_MODE=mock            # mock | real

# ACRCloud (recognition)
ACRCLOUD_HOST=                # e.g. identify-us-west-2.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# LRCLIB needs no key. Set a descriptive user agent.
LRCLIB_USER_AGENT=livelyrics/0.1 (your-email@example.com)

# OpenAI (Whisper, concert mode only)
OPENAI_API_KEY=

# Optional
MOCK_PLAYBACK_RATE=1          # mock mode only: speed of the virtual fixture song (0.5 to 2)
STATIC_DIR=                   # serve a built client from this folder (set in the Docker image)
CACHE_BACKEND=memory          # memory | redis
REDIS_URL=
PORT=8080
